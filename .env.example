POSTGRES_DB=vectra
POSTGRES_USER=vectra
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-password
DATABASE_URL=postgresql+psycopg://vectra:replace-with-a-strong-alphanumeric-password@postgres:5432/vectra
ENVIRONMENT=development
JWT_SECRET=replace-with-a-unique-64-character-random-secret
VECTRA_ADMIN_EMAIL=admin@vectra.local
VECTRA_ADMIN_PASSWORD=
VECTRA_EDUCATOR_EMAIL=educator@vectra.local
VECTRA_EDUCATOR_PASSWORD=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSIONS=2048
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=5120
CORS_ORIGINS=http://localhost:8080
